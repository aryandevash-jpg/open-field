{
  // Type-checks tests and scripts with the same strict settings as src.
  // Used only by `npm run typecheck`; the build still compiles src alone.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
